diff --git a/Tinycast/Features/QuickActions/UI/QuickActionCoordinator.swift b/Tinycast/Features/QuickActions/UI/QuickActionCoordinator.swift
--- a/Tinycast/Features/QuickActions/UI/QuickActionCoordinator.swift
+++ b/Tinycast/Features/QuickActions/UI/QuickActionCoordinator.swift
@@ -309,6 +309,30 @@ final class QuickActionCoordinator {
             })
     }
 
+#if DEBUG
+    func presentButtonsCITest() {
+        panels.onCITestDismiss = {
+            UserDefaults.standard.set(true, forKey: "quickActionButtonsCIDismissed")
+        }
+        let state = QuickActionPanelState(
+            action: .translate,
+            original: "Hello from Tinycast",
+            targetLanguage: Locale.Language(identifier: "fr"))
+        panels.present(
+            state,
+            metrics: settings.interfaceSize.metrics,
+            languages: [],
+            onRetranslate: { _ in },
+            onReplace: { text in
+                UserDefaults.standard.set(text, forKey: "quickActionButtonsCIReplacedText")
+            })
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1) {
+            state.finish("Bonjour from Tinycast")
+            UserDefaults.standard.set(true, forKey: "quickActionButtonsCIReady")
+        }
+    }
+#endif
+
     private func rerun(_ state: QuickActionPanelState, target: NSRunningApplication?) {
         state.restart()
         start { [weak self] in await self?.perform(state, target: target, previewing: true) }
